PORT=3000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:5173,https://your-frontend-domain.com
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Gmail / Nodemailer setup
# MAIL_USER = your Gmail address
# MAIL_APP_PASSWORD = 16-character Google App Password (not your normal Gmail password)
# CONTACT_RECEIVER_EMAIL = the email where you want to receive portfolio form submissions
# MAIL_FROM = optional custom sender label
MAIL_USER=yourgmail@gmail.com
MAIL_APP_PASSWORD=your_16_character_gmail_app_password
CONTACT_RECEIVER_EMAIL=yourgmail@gmail.com
MAIL_FROM="Portfolio Contact <yourgmail@gmail.com>"
